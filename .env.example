# 이 파일을 복사해서 .env 로 저장하고 실제 값을 채워넣으세요.
# .env 파일은 절대 GitHub에 커밋하지 마세요 (.gitignore에 이미 포함되어 있습니다).

# 7명의 분석가용 - 무료 (https://aistudio.google.com/apikey 에서 발급, 카드 등록 불필요)
GEMINI_API_KEY=

# 멍거(길드마스터) 최종 브리핑용 - 유료, 소량만 사용 (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=

# 텔레그램 알림 (선택) - 미설정 시 콘솔에 출력됨
# 1. @BotFather 에게 /newbot 으로 봇 생성 -> 토큰 발급
# 2. 만든 봇과 대화 시작 후, https://api.telegram.org/bot<토큰>/getUpdates 로 chat_id 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 1로 설정하면 API 키 없이 목(mock) 데이터로 전체 파이프라인을 테스트할 수 있습니다.
POTATO_GUILD_MOCK=0
